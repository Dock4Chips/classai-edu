# ==============================================
# ClassAI-Edu 后端环境配置
# 复制为 .env 后按实际环境修改
# ==============================================

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=123456

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DB=classai_edu

# ---------- MinIO ----------
MINIO_ADDRESS=127.0.0.1
MINIO_PORT=9000
MINIO_ADMIN=minioadmin
MINIO_PASSWORD=minioadmin
MINIO_BUCKET_NAME=classai-edu

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:7869/api/strategies/identity/auth/google
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_USER_INFO_URL=https://www.googleapis.com/oauth2/v3/userinfo

# ---------- GitHub OAuth ----------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:7869/api/strategies/identity/auth/github
GITHUB_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_USER_INFO_URL=https://api.github.com/user

# ---------- 指标 / 报表 ----------
DASHBOARD_METRICS_DIR=/Users/xxx/code_workspace/classai-edu/yolo_edu/scripts/metrics
REPORT_MODEL_EXPORT_BASE_PATH=